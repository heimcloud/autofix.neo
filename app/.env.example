# Local dev only (the Nix module renders these from settings.toml).

# Shared secret for POST /api/incidents (Bearer or X-Ops-Secret)
OPS_INGEST_SECRET=
# or a file with the secret (first line)
# OPS_INGEST_SECRET_FILE=

# SQLite (WAL). Container default; Neo mounts appdata → /data
OPS_DB_PATH=/data/ops.sqlite

# Allowlisted targets (JSON). No built-in target; fork is required.
# OPS_TARGETS=[{"upstream":"example-upstream/neo","fork":"example-bot/neo"}]

ADMIN_ENABLED=true
ADMIN_PATH=/admin
ADMIN_READ_ONLY=false

PORT=3000
# Time zone of the board (default TZ, else UTC)
# OPS_TIME_ZONE=Europe/Berlin

# Redaction (comma lists; patterns whitespace-separated)
OPS_REDACT_EXTRA_SLUGS=
# OPS_REDACT_HOSTNAMES=labhost-a,labhost-b
# OPS_REDACT_PATTERNS=[A-Z0-9]{10}
# OPS_PUBLIC_OWNERS=example-upstream,example-bot
